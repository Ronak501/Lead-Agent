# Keep sending disabled until OAuth, approval enforcement, suppression checks, and audit logging are implemented.
EMAIL_SENDING_ENABLED=false
SENDER_NAME=Ronak Talaviya
SENDER_COMPANY=Founder, Ornitech
SENDER_EMAIL=founder@ornitech.in
SENDER_WEBSITE=https://ornitech.in

# Access restriction & Auth (Approach 2)
ALLOWED_OAUTH_DOMAIN=ornitech.in
